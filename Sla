local ActiveNotifs = {}
local MAX_NOTIFS = 3

local function notify(title, text, duration, kind)
    if not settings.notifications then return end
    duration = duration or 3

    -- never let more than MAX_NOTIFS stack up
    while #ActiveNotifs >= MAX_NOTIFS do
        local oldest = table.remove(ActiveNotifs, 1)
        if oldest and oldest.Parent then oldest:Destroy() end
    end

    local holder = ensureNotifHolder()
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 0); card.AutomaticSize = Enum.AutomaticSize.Y
    card.BackgroundColor3 = THEME.row; card.BorderSizePixel = 0; card.ClipsDescendants = true
    card.BackgroundTransparency = 1; card.ZIndex = 1001; card.Parent = holder
    table.insert(ActiveNotifs, card)
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 7)
    local accentColor = kind == "error" and THEME.danger or (kind == "success" and THEME.success or THEME.accent)
    local bar = Instance.new("Frame"); bar.Size = UDim2.new(0, 3, 1, 0); bar.BackgroundColor3 = accentColor; bar.BorderSizePixel = 0; bar.ZIndex = 1002; bar.Parent = card
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 3)
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 12); pad.PaddingRight = UDim.new(0, 9); pad.PaddingTop = UDim.new(0, 7); pad.PaddingBottom = UDim.new(0, 7); pad.Parent = card
    local vlist = Instance.new("UIListLayout"); vlist.SortOrder = Enum.SortOrder.LayoutOrder; vlist.Padding = UDim.new(0, 1); vlist.Parent = card
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, 0, 0, 14); t.BackgroundTransparency = 1; t.Font = FONT_BOLD; t.TextSize = 11
    t.TextColor3 = THEME.text; t.TextXAlignment = Enum.TextXAlignment.Left; t.Text = title or "Notice"; t.LayoutOrder = 1; t.ZIndex = 1002; t.Parent = card
    local b = Instance.new("TextLabel")
    b.Size = UDim2.new(1, 0, 0, 0); b.AutomaticSize = Enum.AutomaticSize.Y; b.BackgroundTransparency = 1; b.Font = FONT_BODY; b.TextSize = 10
    b.TextColor3 = THEME.textDim; b.TextXAlignment = Enum.TextXAlignment.Left; b.TextWrapped = true; b.Text = text or ""; b.LayoutOrder = 2; b.ZIndex = 1002; b.Parent = card

    -- simple fade in/out (a Position slide fights UIListLayout, which repositions children every frame)
    TweenService:Create(card, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
    task.delay(duration, function()
        if card and card.Parent then
            local idx = table.find(ActiveNotifs, card)
            if idx then table.remove(ActiveNotifs, idx) end
            local tw = TweenService:Create(card, TweenInfo.new(0.2), {BackgroundTransparency = 1})
            tw:Play()
            tw.Completed:Connect(function() if card then card:Destroy() end end)
        end
    end)
end

local function applyConfigToControls()
    for key, ctrl in pairs(Controls) do
        local val = configData[key]; if val == nil then val = ctrl.default end; ctrl.set(val, false)
    end
end

local function captureControlValues()
    local data = {}; for key, ctrl in pairs(Controls) do data[key] = ctrl.get() end; return data
end

local function createConfig(n) currentConfigName = n; configData = {}; writeConfig(currentConfigName, configData); syncSettings(); applyConfigToControls(); updateStatus("Created: " .. currentConfigName); notify("Config criada", currentConfigName, 2.5, "success") end
local function saveConfig(silent) configData = captureControlValues(); writeConfig(currentConfigName, configData); syncSettings(); updateStatus("Saved: " .. currentConfigName); if not silent then notify("Config salva", currentConfigName, 2.5, "success") end end
local function loadConfig(n) currentConfigName = n; configData = readConfig(currentConfigName); syncSettings(); applyConfigToControls(); updateStatus("Loaded: " .. currentConfigName); notify("Config carregada", currentConfigName, 2.5) end
local function resetCurrentConfig() configData = resetConfig(currentConfigName); applyConfigToControls(); updateStatus("Reset: " .. currentConfigName); notify("Config resetada", currentConfigName, 2.5) end
local function toggleAuto(key) settings[key] = not settings[key]; writeSettings(settings) end
local function registerControl(id, def, getter, setter)
    Controls[id] = {default = def, get = getter, set = setter}
    local val = configData[id]
    if val == nil then val = def end
    setter(val, true)
end

local function setTabActive(tabName)
    for name, tab in pairs(Tabs) do
        local isActive = name == tabName
        local targetBg = isActive and THEME.accent or THEME.row
        local targetText = isActive and Color3.new(1, 1, 1) or THEME.textDim

        TweenService:Create(tab.button, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {BackgroundColor3 = targetBg, TextColor3 = targetText}):Play()

        if isActive and not tab.container.Visible then
            tab.container.Visible = true; tab.container.GroupTransparency = 1
            TweenService:Create(tab.container, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {GroupTransparency = 0}):Play()
            task.defer(function()
                if tab.api.FirstSection then updateSection(tab.api.FirstSection) end
            end)
        elseif not isActive and tab.container.Visible then
            local tw = TweenService:Create(tab.container, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {GroupTransparency = 1})
            tw:Play(); tw.Completed:Connect(function() if ActiveTab ~= name then tab.container.Visible = false end end)
        end
    end
    ActiveTab = tabName
end

local function createAnimatedBackground(parent)
    local bg = Instance.new("Frame")
    bg.Name = "AnimatedBG"; bg.Size = UDim2.new(1, 0, 1, 0); bg.BackgroundTransparency = 1
    bg.ClipsDescendants = true; bg.ZIndex = 1; bg.Parent = parent
    BubbleContainer = bg

    AnimatedBgEnabled = settings.animatedBg
    if not settings.animatedBg then bg.Visible = false end

    -- Rising ember particles
    for i = 1, 8 do
        local ember = Instance.new("Frame")
        ember.BackgroundColor3 = THEME.accent
        ember.BackgroundTransparency = 0.8
        ember.BorderSizePixel = 0
        local sz = math.random(4, 9)
        ember.Size = UDim2.fromOffset(sz, sz)
        ember.Position = UDim2.new(math.random() * 0.9, 0, 1.1, 0)
        ember.ZIndex = 1; ember.Parent = bg
        Instance.new("UICorner", ember).CornerRadius = UDim.new(1, 0)
        local grad = Instance.new("UIGradient")
        grad.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0.9)})
        grad.Rotation = 90; grad.Parent = ember

        task.spawn(function()
            task.wait(i * 0.8)
            while ember and ember.Parent do
                if not AnimatedBgEnabled then task.wait(0.5); continue end
                local x = math.random() * 0.9
                ember.Position = UDim2.new(x, 0, 1.1, 0)
                ember.BackgroundTransparency = 0.8
                local dur = 8 + math.random() * 8
                TweenService:Create(ember, TweenInfo.new(dur, Enum.EasingStyle.Sine), {Position = UDim2.new(x + (math.random() - 0.5) * 0.1, 0, -0.15, 0), BackgroundTransparency = 1}):Play()
                task.wait(dur)
            end
        end)
    end
    return bg
end

