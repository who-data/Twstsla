            table.insert(resultRows, btn)
        end
        local function refresh()
            clearResults()
            local q = string.lower((input.Text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
            local scored = {}
            for _, e in ipairs(Window.Searchables) do
                if e.Name and e.Name ~= "" then
                    local s = fuzzyScore(e.LowerName or "", q)
                    if s > 0 then table.insert(scored, { e = e, s = s }) end
                end
            end
            table.sort(scored, function(a, b)
                local fa = Window.Favorites[a.e] == true
                local fb = Window.Favorites[b.e] == true
                if fa ~= fb then return fa end
                if a.s == b.s then return (a.e.Name or "") < (b.e.Name or "") end
                return a.s > b.s
            end)
            local limit = math.min(#scored, 40)
            activeMatches = {}
            for i = 1, limit do
                activeMatches[i] = scored[i].e
                buildRow(scored[i].e, i)
            end
            emptyLbl.Visible = (limit == 0)
            activeIdx = math.min(activeIdx, math.max(1, limit))
            highlightActive()
            firstRender = false
        end
        local function queueRefresh()
            searchRefreshStamp = searchRefreshStamp + 1
            local stamp = searchRefreshStamp
            task.delay(0.03, function()
                if stamp ~= searchRefreshStamp then return end
                if not searchVisible then return end
                refresh()
            end)
        end
        input:GetPropertyChangedSignal("Text"):Connect(queueRefresh)
        local PANEL_REST_Y = 70
        local PANEL_OFF_Y  = 78
        local function openSearch()
            if searchVisible then return end
            searchAnimToken = searchAnimToken + 1
            local token = searchAnimToken
            searchVisible = true
            cancelSearchTweens()
            searchRoot.Visible = true
            input.Text = ""
            activeIdx = 1
            searchRoot.BackgroundTransparency = 1
            panel.Position = UDim2.new(0.5, 0, 0, PANEL_OFF_Y)
            panel.BackgroundTransparency = 1
            panelScale.Scale = 1
            panelStroke.Color = theme.GlassRimHi
            panelStroke.Transparency = 1
            firstRender = true
            refresh()
            playSearchTween(searchRoot, 0.20,
                { BackgroundTransparency = 0.5 },
                Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            playSearchTween(panel, 0.24, {
                Position = UDim2.new(0.5, 0, 0, PANEL_REST_Y),
                BackgroundTransparency = 0,
            }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            playSearchTween(panelStroke, 0.24,
                { Transparency = 0.3 },
                Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            task.defer(function()
                if token ~= searchAnimToken or not searchVisible then return end
                pcall(function() input:CaptureFocus() end)
            end)
        end
        closeSearch = function()
            if not searchVisible then return end
            searchAnimToken = searchAnimToken + 1
            local token = searchAnimToken
            searchVisible = false
            cancelSearchTweens()
            pcall(function() input:ReleaseFocus() end)
            playSearchTween(searchRoot, 0.16,
                { BackgroundTransparency = 1 },
                Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            local panelTw = playSearchTween(panel, 0.16, {
                Position = UDim2.new(0.5, 0, 0, PANEL_OFF_Y),
                BackgroundTransparency = 1,
            }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            playSearchTween(panelStroke, 0.14,
                { Transparency = 1 },
                Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            panelTw.Completed:Connect(function()
                if token ~= searchAnimToken then return end
                if not searchVisible then
                    searchRoot.Visible = false
                    panel.Position = UDim2.new(0.5, 0, 0, PANEL_REST_Y)
                    panel.BackgroundTransparency = 0
                    panelScale.Scale = 1
                end
            end)
        end
        backdrop.MouseButton1Click:Connect(closeSearch)
        local searchHintWrap = new("Frame", {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 26),
            LayoutOrder = -1000,
            Parent = tabScroll,
        })
        local searchHintBtn = new("TextButton", {
            BackgroundColor3 = Color3.new(1, 1, 1),
            Size = UDim2.fromScale(1, 1),
            Position = UDim2.fromScale(0, 0),
            Text = "",
            AutoButtonColor = false,
            ClipsDescendants = true,
            ZIndex = 12,
            Parent = searchHintWrap,
        })
        local shStroke, shGrad = applyLiquidGlass(searchHintBtn, theme, 10)
        setGlassGradient(shGrad, theme.TopBar, theme.Card, theme.Sidebar)
        searchHintBtn.BackgroundTransparency = 0.54
        shStroke.Transparency = 0.48
        shStroke.Color = theme.Stroke
        shStroke.Thickness = 1
        new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Enum.Font.GothamBold,
            TextSize = 10,
            TextColor3 = theme.SubText,
            Text = "Press ; to search.",
            TextXAlignment = Enum.TextXAlignment.Center,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = 13,
            Parent = searchHintBtn,
        })
        searchHintBtn.MouseButton1Click:Connect(function()
            openSearch()
        end)
        function Window:OpenSearch()
            openSearch()
        end
        function Window:CloseSearch()
            closeSearch()
        end
        local function canOpenSearchFromHotkey()
            return canvas and canvas.Parent and canvas.Visible and not Window.HiddenByToggle
        end
        UserInputService.InputBegan:Connect(function(inp, gp)
            if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
            local kc = inp.KeyCode
            if not searchVisible then
                if not gp and kc == Enum.KeyCode.Semicolon and canOpenSearchFromHotkey() then
                    openSearch()
                end
                return
            end
            if kc == Enum.KeyCode.Escape then
                closeSearch()
            elseif kc == Enum.KeyCode.Return then
                activateIdx()
            elseif kc == Enum.KeyCode.Down then
                if #activeMatches > 0 then
                    activeIdx = (activeIdx % #activeMatches) + 1
                    highlightActive()
                end
            elseif kc == Enum.KeyCode.Up then
                if #activeMatches > 0 then
                    activeIdx = ((activeIdx - 2) % #activeMatches) + 1
                    highlightActive()
                end
            end
        end)
    end)
    if not searchBootOk then
        function Window:OpenSearch() end
        function Window:CloseSearch() end
        compatWarn("Search disabled on this executor: " .. tostring(searchBootErr))
    end
    if cfg.SettingsTab ~= false then
        task.defer(function()
            if Window and not Window._settingsTabCreated then
                Window._settingsTabCreated = true
                pcall(function()
                    Window:CreateSettingsTab(cfg.SettingsTabOptions)
                end)
            end
        end)
    end
    if cfgSave and (cfgSave.LoadOnStart or cfgSave.AutoLoad) then
        task.defer(function()
            pcall(function()
                Window:LoadConfig(cfgSave.FileName or Window.ConfigFile)
            end)
        end)
    end
    if cfg.EnableGuideNotifications == true then
        task.defer(function()
            local guideFolder = "vantadev"
            local guideFile = guideFolder .. "/ui-guide-seen.txt"
            local seen = false
            pcall(function()
                if isfile and isfile(guideFile) then
                    seen = true
                end
            end)
            if seen then return end
            pcall(function()
                if makefolder and isfolder and not isfolder(guideFolder) then
                    makefolder(guideFolder)
                end
                if writefile then
                    writefile(guideFile, "1")
                end
            end)
            Library:Notify({
                Title = "Vanta UI",
                Content = "Loaded.",
                Duration = 3,
            })
        end)
    end
    Library.Windows[name] = Window
    return Window
end
local notifStack = {}
function Library:Notify(opts)
    opts = opts or {}
    if Library.Flags and Library.Flags["Vanta_Notifications"] == false then
        return
    end
    local notifTitle = tostring(opts.Title or "Notification")
    local notifGui
    for _, host in ipairs(collectGuiHosts()) do
        local existing = host:FindFirstChild("VantaNotifs")
        if existing then
            notifGui = existing
            break
        end
    end
    if not notifGui then
        local ok, created = pcall(function()
            return createScreenGuiWithFallback("VantaNotifs", 10000)
        end)
        if not ok or not created then
            return
        end
        notifGui = created
    end
    local theme = THEME
    local holder = new("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -20, 1, -20 - (#notifStack * 88)),
        Size = UDim2.fromOffset(312, 78),
        BackgroundTransparency = 1,
        Parent = notifGui,
    })
    local shadowMask = new("Frame", {
        Position = UDim2.fromOffset(-16, -16),
        Size = UDim2.new(1, 32, 1, 32),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = holder,
    })
    corner(shadowMask, 20)
    local notifShadow = new("ImageLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Image = SHADOW_ASSET,
        ImageColor3 = Color3.new(0, 0, 0),
        ImageTransparency = 1,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = SHADOW_SLICE,
        Visible = false,
        Parent = shadowMask,
    })
    local glowMask = new("Frame", {
        Position = UDim2.fromOffset(-10, -10),
        Size = UDim2.new(1, 20, 1, 20),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = holder,
    })
    corner(glowMask, 18)
    local notifGlow = new("ImageLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Image = SHADOW_ASSET,
        ImageColor3 = theme.GlassRim,
        ImageTransparency = 1,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = SHADOW_SLICE,
        Visible = false,
        Parent = glowMask,
    })
    local card = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = theme.CardTop,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = holder,
    })
    corner(card, 14)
    local cs = select(1, applyLiquidGlass(card, theme, 14, 0.58))
    card.BackgroundTransparency = 1
    local frost = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = card,
    })
    corner(frost, 14)
    new("UIGradient", {
        Rotation = -28,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(240, 245, 255)),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.45),
            NumberSequenceKeypoint.new(0.45, 0.55),
            NumberSequenceKeypoint.new(1, 0.75),
        }),
        Parent = frost,
    })
    pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://16888522973"
        sound.Volume = 0.6
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        game:GetService("Debris"):AddItem(sound, 3)
    end)
    local tabIconName = opts.TabIcon or opts.Icon
    local iconData
    if tabIconName then
        iconData = resolveIcon(tabIconName)
    end
    if not iconData or not iconData.Image then
        if opts.Image then
            iconData = { Image = opts.Image }
        else
            iconData = { Image = Window.Logo or "rbxassetid://78968317665673" }
        end
    end
    local hasTabIcon = true
    local textOffsetX = hasTabIcon and 54 or 16
    local iconBg, iconImg
    if hasTabIcon then
        iconBg = new("Frame", {
            Position = UDim2.fromOffset(12, 12),
            Size = UDim2.fromOffset(32, 32),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = 1,
            Parent = card,
        })
        corner(iconBg, 99)
        local istroke = new("UIStroke", {
            Color = theme.GlassRimHi or theme.GlassRim,
            Transparency = 1,
            Thickness = 1,
            Parent = iconBg,
        })
        iconImg = new("ImageLabel", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(16, 16),
            BackgroundTransparency = 1,
            ImageColor3 = Color3.fromRGB(40, 40, 40),
            ImageTransparency = 1,
            Image = iconData.Image,
            ImageRectOffset = iconData.ImageRectOffset or Vector2.zero,
            ImageRectSize = iconData.ImageRectSize or Vector2.zero,
            Parent = iconBg,
        })
        tween(iconBg, 0.25, {BackgroundTransparency = 0.4})
        tween(istroke, 0.25, {Transparency = 0.2})
        tween(iconImg, 0.25, {ImageTransparency = 0})
    end
    local ttl = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(textOffsetX, 12),
        Size = UDim2.new(1, -textOffsetX - 16, 0, 18),
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = Color3.fromRGB(30, 30, 30),
        TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = notifTitle,
        Parent = card,
    })
    local body = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(textOffsetX, 34),
        Size = UDim2.new(1, -textOffsetX - 16, 0, 38),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = Color3.fromRGB(70, 70, 70),
        TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Text = opts.Content or "",
        Parent = card,
    })
    table.insert(notifStack, holder)
    local targetCardTransparency = math.clamp((theme.GlassBaseTransparency or 0.38) - 0.05, 0, 0.68)
    local frostTarget = 0
    local strokeTarget = 0.25
    local shadowTarget = 0.4
    local glowTarget = 0.6
    local bodyTarget = 0
    tween(card, 0.25, {BackgroundTransparency = targetCardTransparency})
    tween(frost, 0.25, {BackgroundTransparency = frostTarget})
    tween(cs,   0.25, {Transparency = strokeTarget})
    tween(notifShadow, 0.3, {ImageTransparency = shadowTarget})
    tween(notifGlow,   0.3, {ImageTransparency = glowTarget})
    tween(ttl,  0.25, {TextTransparency = 0})
    tween(body, 0.3,  {TextTransparency = bodyTarget})
    task.delay(opts.Duration or 4, function()
        tween(card, 0.25, {BackgroundTransparency = 1})
        tween(frost, 0.25, {BackgroundTransparency = 1})
        tween(cs,   0.25, {Transparency = 1})
        tween(notifShadow, 0.25, {ImageTransparency = 1})
        tween(notifGlow,   0.25, {ImageTransparency = 1})
        if hasTabIcon then
            tween(iconBg, 0.25, {BackgroundTransparency = 1})
            local s = iconBg:FindFirstChildOfClass("UIStroke")
            if s then tween(s, 0.25, {Transparency = 1}) end
            tween(iconImg, 0.25, {ImageTransparency = 1})
        end
        tween(ttl,  0.25, {TextTransparency = 1})
        local t = tween(body, 0.25, {TextTransparency = 1})
        t.Completed:Connect(function()
            for i, c in ipairs(notifStack) do
                if c == holder then table.remove(notifStack, i) break end
            end
            holder:Destroy()
            for i, c in ipairs(notifStack) do
                tween(c, 0.2, {Position = UDim2.new(1, -20, 1, -20 - ((i-1) * 88))})
            end
        end)
    end)
end
return Library
