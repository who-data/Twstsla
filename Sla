                        AutoButtonColor = false,
                        ClipsDescendants = true,
                        Parent = listScroll,
                    })
                    corner(ob, 10)
                    ob.MouseEnter:Connect(function()
                        tween(ob, 0.1, {BackgroundTransparency = 0, BackgroundColor3 = theme.AccentMid})
                    end)
                    ob.MouseLeave:Connect(function()
                        local stillSel = multi and selected[opt] or (not multi and selected == opt)
                        tween(ob, 0.12, {
                            BackgroundTransparency = stillSel and 0 or 1,
                            BackgroundColor3 = stillSel and theme.Accent or theme.Row,
                        })
                    end)
                    ob.MouseButton1Down:Connect(function(x, y) ripple(ob, x, y, theme.AccentHi) end)
                    ob.MouseButton1Click:Connect(function()
                        if multi then
                            selected[opt] = not selected[opt]
                            val.Text = displayText()
                            ob.Text = "   " .. opt .. (selected[opt] and "   \u{2713}" or "")
                            ob.BackgroundColor3 = theme.Accent
                            ob.BackgroundTransparency = selected[opt] and 0 or 1
                            local list = {}
                            for _, o in ipairs(options) do if selected[o] then table.insert(list, o) end end
                            if opts.Flag then Library.Flags[opts.Flag] = list end
                            if opts.Callback then task.spawn(opts.Callback, list) end
                            if opts.Flag then scheduleAutoSave() end
                            if opts.Flag then queueAutoControlStateSave() end
                        else
                            selected = opt
                            val.Text = opt
                            refresh()
                            tween(row, 0.22, {Size = UDim2.new(1, -8, 0, COLLAPSED_H)})
                            tween(listScroll, 0.22, {Size = UDim2.new(1, -20, 0, 0)})
                            tween(caret, 0.22, {Rotation = 0})
                            task.delay(0.22, function() listScroll.Visible = false end)
                            if opts.Flag then Library.Flags[opts.Flag] = opt end
                            if opts.Callback then task.spawn(opts.Callback, opt) end
                            if opts.Flag then scheduleAutoSave() end
                            if opts.Flag then queueAutoControlStateSave() end
                        end
                    end)
                    table.insert(optButtons, ob)
                end
            end
            refresh()
            if opts.Flag then
                if multi then
                    local list = {}
                    for _, o in ipairs(options) do if selected[o] then table.insert(list, o) end end
                    Library.Flags[opts.Flag] = list
                else
                    Library.Flags[opts.Flag] = selected
                end
            end
            local open = false
            hit.MouseButton1Click:Connect(function()
                open = not open
                local raw = #options * (OPT_H + 3) + 12
                local list_h = math.min(raw, MAX_LIST)
                if open then
                    listScroll.Visible = true
                    tween(row, 0.24, {Size = UDim2.new(1, -8, 0, COLLAPSED_H + list_h + 10)})
                    tween(listScroll, 0.24, {Size = UDim2.new(1, -20, 0, list_h)})
                    tween(caret, 0.24, {Rotation = 180})
                else
                    tween(row, 0.24, {Size = UDim2.new(1, -8, 0, COLLAPSED_H)})
                    tween(listScroll, 0.24, {Size = UDim2.new(1, -20, 0, 0)})
                    tween(caret, 0.24, {Rotation = 0})
                    task.delay(0.24, function() if not open then listScroll.Visible = false end end)
                end
            end)
            addOrder(row)
            registerSearch(opts.Name, row, "dropdown", opts.Flag, nil)
            local obj = {}
            function obj:Set(v, fire)
                if fire == nil then fire = true end
                if multi then
                    selected = {}
                    if type(v) == "table" then for _, x in ipairs(v) do selected[x] = true end end
                else
                    if type(v) == "table" then v = v[1] end
                    selected = v
                end
                val.Text = displayText()
                refresh()
                if opts.Flag then
                    if multi then
                        local list = {}
                        for _, o in ipairs(options) do if selected[o] then table.insert(list, o) end end
                        Library.Flags[opts.Flag] = list
                        if fire and opts.Callback then
                            task.spawn(opts.Callback, list)
                        end
                    else
                        Library.Flags[opts.Flag] = selected
                        if fire and opts.Callback then
                            task.spawn(opts.Callback, selected)
                        end
                    end
                    if fire then
                        scheduleAutoSave()
                        queueAutoControlStateSave()
                    end
                end
            end
            function obj:Refresh(newOpts)
                options = newOpts or {}
                if multi then
                    local kept = {}
                    for _, o in ipairs(options) do if selected[o] then kept[o] = true end end
                    selected = kept
                else
                    local found = false
                    for _, o in ipairs(options) do if o == selected then found = true break end end
                    if not found then selected = options[1] end
                end
                val.Text = displayText()
                refresh()
            end
            function obj:Get()
                if multi then
                    local l = {}
                    for _, o in ipairs(options) do if selected[o] then table.insert(l, o) end end
                    return l
                else
                    return selected
                end
            end
            registerFlagControl(opts.Flag, obj)
            return obj
        end
