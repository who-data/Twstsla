--[[------------------------------------------------------------------------
    Vanta UI Extension  -  SubTab + Enhanced ColorPicker (HSV / RGB / HEX)
    ------------------------------------------------------------------------
    Paste these two functions inside the Tab's method block (after the
    existing CreateInput function and before CreateKeybind or wherever
    you prefer).  They use the same helpers the library already exposes:
        new, corner, stroke, padding, tween, applyLiquidGlass,
        setGlassGradient, ripple, rgbToHsv, hsvToRgb, addOrder,
        registerSearch, registerFlagControl, Library, Window, theme,
        TweenService, UserInputService

    Usage
    ------
    local sub = Tab:CreateSubTab({
        Names  = { "Combat", "Movement", "Render" },
    })
    sub:GetTab("Combat"):CreateToggle({ Name = "Kill All", Flag = "ka" })
    sub:GetTab("Movement"):CreateSlider({ Name = "Speed", Range = {1,100}, Flag = "sp" })
    sub:GetTab("Render"):CreateColorPicker({ Name = "ESP Color", Flag = "espc" })

    Tab:CreateColorPicker({
        Name     = "Chams Color",
        Color    = Color3.fromRGB(255, 80, 80),
        Flag     = "chamcol",
        Callback = function(c) print(c) end,
    })
------------------------------------------------------------------------]]

-- =======================================================================
--  SubTab Component
-- =======================================================================
function Tab:CreateSubTab(opts)
    opts = opts or {}
    local tabNames = opts.Names or { "Tab 1", "Tab 2" }
    local defaultIdx = opts.DefaultIndex or 1
    if defaultIdx < 1 then defaultIdx = 1 end
    if defaultIdx > #tabNames then defaultIdx = #tabNames end

    local TAB_BAR_H = 36
    local CONTAINER_H = 220
    local TOTAL_H = TAB_BAR_H + CONTAINER_H + 4

    -- Outer holder
    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -8, 0, TOTAL_H),
        ClipsDescendants = true,
        BorderSizePixel = 0,
    })

    -- Tab bar background (glass)
    local tabBar = new("Frame", {
        Size = UDim2.new(1, 0, 0, TAB_BAR_H),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = holder,
    })
    local barStroke, barGrad = applyLiquidGlass(tabBar, theme, 10)
    tabBar.BackgroundTransparency = 0.48
    barStroke.Transparency = 0.5

    -- Tab buttons container (horizontal list)
    local tabList = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = tabBar,
    })
    local tabLayout = new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
        Parent = tabList,
    })
    padding(tabList, 4, 4, 4, 4)

    -- Content area below tab bar
    local contentArea = new("Frame", {
        Position = UDim2.fromOffset(0, TAB_BAR_H + 4),
        Size = UDim2.new(1, 0, 0, CONTAINER_H),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = holder,
    })

    -- Active underline indicator
    local indicator = new("Frame", {
        Size = UDim2.new(0, 0, 0, 2),
        BackgroundColor3 = theme.AccentHi,
        BorderSizePixel = 0,
        ZIndex = 10,
        Parent = tabBar,
    })
    corner(indicator, 999)

    -- Internal state
    local subTabs = {}       -- { btn, label, page, addOrder, registerSearch, registerFlagControl }
    local activeIdx = defaultIdx
    local animToken = 0

    -- Create each sub-tab button + page
    for i, name in ipairs(tabNames) do
        local btn = new("TextButton", {
            Size = UDim2.new(1, -8, 1, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            LayoutOrder = i - 1,
            Parent = tabList,
        })
        corner(btn, 8)

        local lbl = new("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Center,
            Text = name,
            ZIndex = 2,
            Parent = btn,
        })

        -- Page (scrolling frame for content)
        local page = new("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ElasticBehavior = Enum.ElasticBehavior.Never,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = theme.Accent,
            ScrollBarImageTransparency = 0.4,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            Visible = (i == defaultIdx),
            ZIndex = 5,
            Parent = contentArea,
        })
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
            Parent = page,
        })
        padding(page, 8, 8, 8, 8)

        -- Hover effect
        btn.MouseEnter:Connect(function()
            if i ~= activeIdx then
                tween(btn, 0.15, { BackgroundTransparency = 0.65 })
                tween(lbl, 0.15, { TextColor3 = theme.Text })
            end
        end)
        btn.MouseLeave:Connect(function()
            if i ~= activeIdx then
                tween(btn, 0.15, { BackgroundTransparency = 1 })
                tween(lbl, 0.15, { TextColor3 = theme.SubText })
            end
        end)
        btn.MouseButton1Down:Connect(function(x, y)
            ripple(btn, x, y, theme.AccentHi)
        end)

        local entry = {
            Index = i,
            Name = name,
            Button = btn,
            Label = lbl,
            Page = page,
        }

        -- Closure to add child components to this sub-tab's page
        function entry.addOrder(elem)
            elem.LayoutOrder = #page:GetChildren()
            elem.Parent = page
        end
        function entry.registerSearch(name, frame, kind, flag, obj, desc)
            if not name or name == "" then return end
                local searchEntry = {
                    Name = name,
                    LowerName = string.lower(name),
                    Tab = Tab,
                    Frame = frame,
                    Kind = kind,
                    Flag = flag,
                    Obj = obj,
                    Description = desc,
                }
                table.insert(Window.Searchables, searchEntry)
                if flag and flag ~= "" then
                    Window.SearchByFlag[flag] = searchEntry
                end
            end
        function entry.registerFlagControl(flag, obj)
            if type(flag) ~= "string" or flag == "" then return end
            if type(obj) ~= "table" or type(obj.Set) ~= "function" then return end
            Window.FlagControls[flag] = obj
            local pending = Window.PendingConfigFlags[flag]
            if pending ~= nil then
                local ok = pcall(function() obj:Set(pending) end)
                if ok then Window.PendingConfigFlags[flag] = nil end
            end
            local pendingAuto = Window.PendingAutoControlFlags[flag]
            if pendingAuto ~= nil then
                local ok = pcall(function() obj:Set(pendingAuto, false) end)
                if ok then Window.PendingAutoControlFlags[flag] = nil end
            end
        end

        -- Delegate standard Tab component creators into this sub-tab
        function entry:CreateSection(text)
            local h = new("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -4, 0, 26),
            })
            new("Frame", {
                AnchorPoint = Vector2.new(0, 1),
                Position = UDim2.new(0, 0, 1, -2),
                Size = UDim2.new(1, 0, 0, 1),
                BackgroundColor3 = theme.Stroke,
                BackgroundTransparency = 0.4,
                BorderSizePixel = 0,
                Parent = h,
            })
            local l = new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 20),
                Font = Enum.Font.GothamBlack,
                TextSize = 11,
                TextColor3 = theme.AccentHi,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = string.upper(text or "SECTION"),
                Parent = h,
            })
            self.addOrder(h)
            self.registerSearch(text, h, "section", nil, nil)
            local o = {}
            function o:Set(t) l.Text = string.upper(t or "") end
            return o
        end

        function entry:CreateLabel(text)
            local l = new("TextLabel", {
                BackgroundColor3 = Color3.new(1, 1, 1),
                Size = UDim2.new(1, -4, 0, 34),
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                TextColor3 = theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "  " .. (text or ""),
                BorderSizePixel = 0,
            })
            applyLiquidGlass(l, theme, 10)
            self.addOrder(l)
            self.registerSearch(text, l, "label", nil, nil)
            local o = {}
            function o:Set(t) l.Text = "  " .. (t or "") end
            return o
        end

        function entry:CreateButton(opts)
            opts = opts or {}
            local b = new("TextButton", {
                BackgroundColor3 = Color3.new(1, 1, 1),
                Size = UDim2.new(1, -4, 0, 40),
                Text = "",
                AutoButtonColor = false,
                BorderSizePixel = 0,
                ClipsDescendants = true,
            })
            local bs = select(1, applyLiquidGlass(b, theme, 10))
            local bl = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(14, 0),
                Size = UDim2.new(1, -38, 1, 0),
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextColor3 = theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = opts.Name or "Button",
                Parent = b,
            })
            b.MouseEnter:Connect(function()
                tween(b, 0.12, {BackgroundTransparency = theme.GlassHoverTransparency})
                tween(bs, 0.12, {Transparency = 0.15, Color = theme.GlassRimHi})
                tween(bl, 0.12, {TextColor3 = theme.AccentHi})
            end)
            b.MouseLeave:Connect(function()
                tween(b, 0.12, {BackgroundTransparency = theme.GlassBaseTransparency})
                tween(bs, 0.12, {Transparency = 0.42, Color = theme.GlassRim})
                tween(bl, 0.12, {TextColor3 = theme.Text})
            end)
            b.MouseButton1Down:Connect(function(x, y) ripple(b, x, y, theme.AccentHi) end)
            b.MouseButton1Click:Connect(function()
                if opts.Callback then task.spawn(opts.Callback) end
            end)
            self.addOrder(b)
            self.registerSearch(opts.Name, b, "button", nil, nil)
            local o = {}
            function o:Set(nm) bl.Text = nm end
            return o
        end

        function entry:CreateToggle(opts)
            opts = opts or {}
            local state = opts.CurrentValue and true or false
            local r = new("TextButton", {
                BackgroundColor3 = Color3.new(1, 1, 1),
                Size = UDim2.new(1, -4, 0, 40),
                Text = "",
                AutoButtonColor = false,
                BorderSizePixel = 0,
                ClipsDescendants = true,
            })
            local rs = select(1, applyLiquidGlass(r, theme, 10))
            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(14, 0),
                Size = UDim2.new(1, -60, 1, 0),
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextColor3 = theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = opts.Name or "Toggle",
                Parent = r,
            })
            local track = new("Frame", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -14, 0.5, 0),
                Size = UDim2.fromOffset(38, 20),
                BackgroundColor3 = theme.TrackOff,
                BorderSizePixel = 0,
                Parent = r,
            })
            corner(track, 999)
            local knob = new("Frame", {
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.fromOffset(2, 0),
                Size = UDim2.fromOffset(16, 16),
                BackgroundColor3 = theme.Muted,
                BorderSizePixel = 0,
                ZIndex = 5,
                Parent = track,
            })
            corner(knob, 999)
            local function apply(v, fire)
                state = v
                if state then
                    tween(track, 0.25, {BackgroundColor3 = theme.Accent})
                    tween(knob, 0.25, {Position = UDim2.fromOffset(20, 0), BackgroundColor3 = Color3.new(1,1,1)})
                else
                    tween(track, 0.25, {BackgroundColor3 = theme.TrackOff})
                    tween(knob, 0.25, {Position = UDim2.fromOffset(2, 0), BackgroundColor3 = theme.Muted})
                end
                if opts.Flag then Library.Flags[opts.Flag] = state end
                if fire and opts.Callback then task.spawn(opts.Callback, state) end
                if fire and opts.Flag then
                    pcall(function() scheduleAutoSave() end)
                    pcall(function() queueAutoControlStateSave() end)
                end
            end
            r.MouseEnter:Connect(function()
                tween(r, 0.12, {BackgroundTransparency = theme.GlassHoverTransparency})
                tween(rs, 0.12, {Transparency = 0.15, Color = theme.GlassRimHi})
            end)
            r.MouseLeave:Connect(function()
                tween(r, 0.12, {BackgroundTransparency = theme.GlassBaseTransparency})
                tween(rs, 0.12, {Transparency = 0.42, Color = theme.GlassRim})
            end)
            r.MouseButton1Down:Connect(function(x, y) ripple(r, x, y, theme.AccentHi) end)
            r.MouseButton1Click:Connect(function() apply(not state, true) end)
            apply(state, false)
            if opts.Flag then Library.Flags[opts.Flag] = state end
            self.addOrder(r)
            self.registerSearch(opts.Name, r, "toggle", opts.Flag, nil)
            local o = {}
            function o:Set(v) apply(v, true) end
            function o:Get() return state end
            self.registerFlagControl(opts.Flag, o)
            return o
        end

        function entry:CreateSlider(opts)
            opts = opts or {}
            local rng = opts.Range or {0, 100}
            local minV, maxV = rng[1], rng[2]
            local inc = opts.Increment or 1
            local suffix = opts.Suffix or ""
            local value = opts.CurrentValue or minV
            local r = new("Frame", {
                BackgroundColor3 = Color3.new(1, 1, 1),
                Size = UDim2.new(1, -4, 0, 58),
                BorderSizePixel = 0,
            })
            local rss = select(1, applyLiquidGlass(r, theme, 10))
            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(14, 6),
                Size = UDim2.new(1, -70, 0, 16),
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                TextColor3 = theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = opts.Name or "Slider",
                Parent = r,
            })
            local valLbl = new("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -14, 0, 6),
                Size = UDim2.fromOffset(56, 16),
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                TextColor3 = theme.AccentHi,
                TextXAlignment = Enum.TextXAlignment.Right,
                Text = tostring(value) .. suffix,
                Parent = r,
            })
            local track = new("Frame", {
                Position = UDim2.fromOffset(14, 30),
                Size = UDim2.new(1, -28, 0, 8),
                BackgroundColor3 = theme.TrackOff,
                BorderSizePixel = 0,
                Parent = r,
            })
            corner(track, 999)
            local fill = new("Frame", {
                Size = UDim2.fromScale(0, 1),
                BackgroundColor3 = theme.Accent,
                BorderSizePixel = 0,
                Parent = track,
            })
            corner(fill, 999)
            new("UIGradient", {
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, theme.AccentMid),
                    ColorSequenceKeypoint.new(1, theme.AccentHi),
                }),
                Parent = fill,
            })
            local knob = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0, 0.5),
                Size = UDim2.fromOffset(14, 14),
                BackgroundColor3 = Color3.fromRGB(235, 238, 245),
                BorderSizePixel = 0,
                Parent = track,
            })
            corner(knob, 999)
            local knobStroke = select(1, applyLiquidGlass(knob, theme, 999))
            knob.BackgroundTransparency = 0.25
            knobStroke.Color = theme.GlassRimHi
            knobStroke.Thickness = 1.5
            knobStroke.Transparency = 0.25
            local function setValue(v, fire)
                v = math.clamp(v, minV, maxV)
                v = math.floor((v - minV) / inc + 0.5) * inc + minV
                v = math.clamp(v, minV, maxV)
                value = v
                local a = (v - minV) / (maxV - minV)
                fill.Size = UDim2.fromScale(a, 1)
                knob.Position = UDim2.new(a, 0, 0.5, 0)
                valLbl.Text = tostring(v) .. suffix
                if opts.Flag then Library.Flags[opts.Flag] = v end
                if fire and opts.Callback then task.spawn(opts.Callback, v) end
            end
            setValue(value, false)
            r.MouseEnter:Connect(function()
                tween(r, 0.12, {BackgroundTransparency = theme.GlassHoverTransparency})
                tween(rss, 0.12, {Transparency = 0.15, Color = theme.GlassRimHi})
            end)
            r.MouseLeave:Connect(function()
                tween(r, 0.12, {BackgroundTransparency = theme.GlassBaseTransparency})
                tween(rss, 0.12, {Transparency = 0.42, Color = theme.GlassRim})
            end)
            local sliding = false
            local function fromInput(pos)
                local ap, as = track.AbsolutePosition, track.AbsoluteSize
                local rel = math.clamp((pos.X - ap.X) / as.X, 0, 1)
                setValue(minV + rel * (maxV - minV), true)
            end
            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                   or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true; fromInput(input.Position)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
                   or input.UserInputType == Enum.UserInputType.Touch) then
                    fromInput(input.Position)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                   or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
            self.addOrder(r)
            self.registerSearch(opts.Name, r, "slider", opts.Flag, nil)
            local o = {}
            function o:Set(v, fire) setValue(v, fire ~= false) end
            function o:Get() return value end
            self.registerFlagControl(opts.Flag, o)
            return o
        end

        function entry:CreateDropdown(opts)
            opts = opts or {}
            local options = opts.Options or {}
            local selected = opts.CurrentOption or options[1]
            local COLLAPSED_H = 40
            local OPT_H = 30
            local MAX_LIST = 160
            local r = new("Frame", {
                BackgroundColor3 = Color3.new(1, 1, 1),
                Size = UDim2.new(1, -4, 0, COLLAPSED_H),
                BorderSizePixel = 0,
                ClipsDescendants = true,
            })
            local ds = select(1, applyLiquidGlass(r, theme, 10))
            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(14, 0),
                Size = UDim2.new(1, -46, 0, COLLAPSED_H),
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextColor3 = theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = opts.Name or "Dropdown",
                Parent = r,
            })
            local arrow = new("TextLabel", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -14, 0.5, 0),
                Size = UDim2.fromOffset(20, 20),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextSize = 14,
                TextColor3 = theme.Muted,
                Text = "v",
                TextXAlignment = Enum.TextXAlignment.Center,
                Parent = r,
            })
            local list = new("Frame", {
                Position = UDim2.fromOffset(0, COLLAPSED_H + 2),
                Size = UDim2.new(1, 0, 0, 0),
                BackgroundColor3 = theme.Row,
                BorderSizePixel = 0,
                Visible = false,
                ClipsDescendants = true,
                ZIndex = 20,
                Parent = r,
            })
            corner(list, 8)
            stroke(list, theme.Stroke, 1, 0.5)
            local listLayout = new("UIListLayout", {
                FillDirection = Enum.FillDirection.Vertical,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2),
                Parent = list,
            })
            padding(list, 4, 4, 4, 4)
            local isOpen = false
            local listHeight = 0
            local function makeItem(it)
                local btn = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, OPT_H),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BackgroundTransparency = 0.7,
                    Text = "",
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    LayoutOrder = listHeight,
                    Parent = list,
                })
                corner(btn, 6)
                local lbl = new("TextLabel", {
                    Size = UDim2.new(1, -12, 1, 0),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.GothamBold,
                    TextSize = 12,
                    TextColor3 = selected == it and theme.AccentHi or theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Text = it,
                    Parent = btn,
                })
                padding(lbl, 0, 0, 0, 8)
                btn.MouseEnter:Connect(function()
                    tween(btn, 0.12, {BackgroundTransparency = 0.4})
                end)
                btn.MouseLeave:Connect(function()
                    tween(btn, 0.12, {BackgroundTransparency = 0.7})
                end)
                btn.MouseButton1Click:Connect(function()
                    selected = it
                    if opts.Flag then Library.Flags[opts.Flag] = selected end
                    if opts.Callback then task.spawn(opts.Callback, selected) end
                    -- update label
                    for _, child in ipairs(list:GetChildren()) do
                        if child:IsA("TextButton") then
                            local cl = child:FindFirstChildOfClass("TextLabel")
                            if cl then
                                cl.TextColor3 = cl.Text == selected and theme.AccentHi or theme.Text
                            end
                        end
                    end
                end)
                listHeight = listHeight + 1
            end
            for _, it in ipairs(options) do makeItem(it) end
            r.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                   or input.UserInputType == Enum.UserInputType.Touch then
                    isOpen = not isOpen
                    if isOpen then
                        list.Visible = true
                        local neededH = math.min(#options * (OPT_H + 2) + 8, MAX_LIST)
                        tween(r, 0.22, {Size = UDim2.new(1, -4, 0, COLLAPSED_H + neededH)})
                        tween(arrow, 0.22, {Rotation = 180})
                    else
                        tween(r, 0.22, {Size = UDim2.new(1, -4, 0, COLLAPSED_H)})
                        tween(arrow, 0.22, {Rotation = 0})
                        task.delay(0.22, function() if not isOpen then list.Visible = false end end)
                    end
                end
            end)
            r.MouseEnter:Connect(function()
                tween(r, 0.12, {BackgroundTransparency = theme.GlassHoverTransparency})
                tween(ds, 0.12, {Transparency = 0.15, Color = theme.GlassRimHi})
            end)
            r.MouseLeave:Connect(function()
                tween(r, 0.12, {BackgroundTransparency = theme.GlassBaseTransparency})
                tween(ds, 0.12, {Transparency = 0.42, Color = theme.GlassRim})
            end)
            self.addOrder(r)
            self.registerSearch(opts.Name, r, "dropdown", opts.Flag, nil)
            local o = {}
            function o:Set(v) selected = v end
            function o:Get() return selected end
            self.registerFlagControl(opts.Flag, o)
            return o
        end

        function entry:CreateInput(opts)
            opts = opts or {}
            local value = opts.CurrentValue or ""
            local r = new("Frame", {
                BackgroundColor3 = Color3.new(1, 1, 1),
                Size = UDim2.new(1, -4, 0, 48),
                BorderSizePixel = 0,
            })
            local s = select(1, applyLiquidGlass(r, theme, 10))
            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(14, 6),
                Size = UDim2.new(1, -28, 0, 12),
                Font = Enum.Font.Gotham,
                TextSize = 10,
                TextColor3 = theme.SubText,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = opts.Name or "Input",
                Parent = r,
            })
            local tb = new("TextBox", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(14, 22),
                Size = UDim2.new(1, -28, 0, 20),
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                TextColor3 = theme.Text,
                PlaceholderText = opts.PlaceholderText or "",
                PlaceholderColor3 = theme.Muted,
                Text = value,
                TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                Parent = r,
            })
            tb.Focused:Connect(function()
                tween(s, 0.15, {Transparency = 0.08, Color = theme.AccentHi})
            end)
            tb.FocusLost:Connect(function(enter)
                tween(s, 0.15, {Transparency = 0.42, Color = theme.GlassRim})
                value = tb.Text
                if opts.Flag then Library.Flags[opts.Flag] = value end
                if opts.Callback then task.spawn(opts.Callback, value, enter) end
            end)
            self.addOrder(r)
            self.registerSearch(opts.Name, r, "input", opts.Flag, nil)
            local o = {}
            function o:Set(t) tb.Text = t or ""; value = tb.Text; if opts.Flag then Library.Flags[opts.Flag] = value end end
            function o:Get() return value end
            self.registerFlagControl(opts.Flag, o)
            return o
        end

        subTabs[i] = entry
    end

    -- Switch function
    local function selectSubTab(idx)
        if idx < 1 or idx > #subTabs or idx == activeIdx then return end
        animToken = animToken + 1
        local token = animToken

        -- Deactivate old
        local old = subTabs[activeIdx]
        if old then
            tween(old.Button, 0.18, {BackgroundTransparency = 1})
            tween(old.Label, 0.18, {TextColor3 = theme.SubText})
            old.Page.Visible = false
        end

        -- Activate new
        activeIdx = idx
        local nw = subTabs[idx]
        nw.Page.Visible = true
        tween(nw.Button, 0.18, {BackgroundTransparency = 0.6})
        tween(nw.Label, 0.18, {TextColor3 = theme.AccentDeep})

        -- Slide indicator
        pcall(function()
            local bx = nw.Button.AbsolutePosition.X - tabBar.AbsolutePosition.X
            local bw = nw.Button.AbsoluteSize.X
            tween(indicator, 0.25, {
                Position = UDim2.fromOffset(bx, TAB_BAR_H - 2),
                Size = UDim2.fromOffset(bw, 2),
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        end)

        -- Animate page content in
        nw.Page.Position = UDim2.fromOffset(8, 0)
        tween(nw.Page, 0.2, {Position = UDim2.fromOffset(0, 0)}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    end

    -- Wire click events
    for i, entry in ipairs(subTabs) do
        entry.Button.MouseButton1Click:Connect(function() selectSubTab(i) end)
    end

    -- Set initial active
    task.defer(function()
        local init = subTabs[activeIdx]
        if init then
            init.Button.BackgroundTransparency = 0.6
            init.Label.TextColor3 = theme.AccentDeep
            pcall(function()
                local bx = init.Button.AbsolutePosition.X - tabBar.AbsolutePosition.X
                local bw = init.Button.AbsoluteSize.X
                indicator.Position = UDim2.fromOffset(bx, TAB_BAR_H - 2)
                indicator.Size = UDim2.fromOffset(bw, 2)
            end)
        end
    end)

    -- Theme refresher
    registerThemeRefresher(function()
        for i, entry in ipairs(subTabs) do
            if i == activeIdx then
                entry.Label.TextColor3 = theme.AccentDeep
                entry.Button.BackgroundTransparency = 0.6
            else
                entry.Label.TextColor3 = theme.SubText
                entry.Button.BackgroundTransparency = 1
            end
        end
        indicator.BackgroundColor3 = theme.AccentHi
    end)

    addOrder(holder)
    registerSearch(opts.Name or "SubTab", holder, "subtab", nil, nil)

    -- Public API
    local api = {}
    function api:GetTab(nameOrIndex)
        if type(nameOrIndex) == "number" then
            return subTabs[nameOrIndex]
        end
        if type(nameOrIndex) == "string" then
            for _, e in ipairs(subTabs) do
                if e.Name == nameOrIndex then return e end
            end
        end
        return nil
    end
    function api:SetActive(nameOrIndex)
        if type(nameOrIndex) == "number" then
            selectSubTab(nameOrIndex)
        elseif type(nameOrIndex) == "string" then
            for i, e in ipairs(subTabs) do
                if e.Name == nameOrIndex then selectSubTab(i); return end
            end
        end
    end
    function api:GetActive() return activeIdx end
    function api:SetHeight(h) holder.Size = UDim2.new(1, -8, 0, h) end

    return api
end


