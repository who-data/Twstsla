    do
        local FIT_MARGIN = MOBILE and 0.98 or 0.92
        local function viewportSize()
            local a = canvas.AbsoluteSize
            if a and a.X > 0 and a.Y > 0 then return a end
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize
            if vp and vp.X > 0 and vp.Y > 0 then return vp end
            return nil
        end
        local function applyFitScale()
            local vp = viewportSize()
            if not vp then return end
            local s = math.min(1, (vp.X * FIT_MARGIN) / WIN_W, (vp.Y * FIT_MARGIN) / WIN_H)
            if s ~= s then return end
            fitScale.Scale = math.clamp(s, 0.4, 1)
        end
        canvas:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyFitScale)
        local camConn
        local function hookCamera()
            if camConn then camConn:Disconnect() end
            local cam = workspace.CurrentCamera
            if cam then
                camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyFitScale)
