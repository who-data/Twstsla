            local sl = rgbSliders[ch]
            local val = channelValues[ch]
            local rel = val / 255
            sl.Fill.Size = UDim2.fromScale(rel, 1)
            sl.Knob.Position = UDim2.new(rel, 0, 0.5, 0)
            sl.ValLabel.Text = tostring(val)
            rgbLabels[ch].Text = tostring(val)
        end
        -- Hex
        local hexStr = string.format("%02X%02X%02X", r, g, b)
        if not hexBox:IsFocused() then
            hexBox.Text = hexStr
        end
        -- Preview
        fireUpdate()
    end

    -- Parse hex string and apply
    local function parseHexAndApply(str)
        str = string.gsub(str, "^#", "")
        str = string.gsub(str, "^0x", "")
        if #str ~= 6 then return false end
        local ok, rr, gg, bb = pcall(function()
            return tonumber(str:sub(1, 2), 16) or 0,
                   tonumber(str:sub(3, 4), 16) or 0,
                   tonumber(str:sub(5, 6), 16) or 0
        end)
        if ok then
            color = Color3.fromRGB(rr, gg, bb)
            h, s, v = rgbToHsv(color)
            syncUI()
            return true
        end
        return false
    end

    -- ====== MODE SWITCHING ======
    local modePanelH = {
        HSV = HSV_PANEL_H - 12,
        RGB = RGB_PANEL_H - 12,
        HEX = HEX_PANEL_H - 12,
    }

    local function switchMode(newMode)
        if newMode == activeMode then return end
        activeMode = newMode

        -- Update mode button styles
        for m, data in pairs(modeBtns) do
            if m == newMode then
                tween(data.Button, 0.15, {BackgroundTransparency = 0.55})
                tween(data.Label, 0.15, {TextColor3 = theme.AccentDeep})
            else
                tween(data.Button, 0.15, {BackgroundTransparency = 1})
                tween(data.Label, 0.15, {TextColor3 = theme.Muted})
            end
        end

        -- Show/hide containers
        hsvContainer.Visible = (newMode == "HSV")
        hueBar.Visible = (newMode == "HSV")
        rgbContainer.Visible = (newMode == "RGB")
        hexContainer.Visible = (newMode == "HEX")

        -- Resize panel
        local targetH = modePanelH[newMode] or HSV_PANEL_H - 12
        tween(panel, 0.22, {Size = UDim2.new(1, -28, 0, targetH)}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

        -- Sync UI for the new mode
        syncUI()
    end

    -- Wire mode buttons
    for i, modeName in ipairs(modes) do
        modeBtns[modeName].Button.MouseButton1Click:Connect(function()
            switchMode(modeName)
        end)
        modeBtns[modeName].Button.MouseEnter:Connect(function()
            if modeName ~= activeMode then
                tween(modeBtns[modeName].Button, 0.12, {BackgroundTransparency = 0.7})
            end
        end)
        modeBtns[modeName].Button.MouseLeave:Connect(function()
            if modeName ~= activeMode then
                tween(modeBtns[modeName].Button, 0.12, {BackgroundTransparency = 1})
            end
        end)
    end

    -- ====== HSV DRAGGING ======
    local dragSV, dragHue = false, false

    local function svFromInput(pos)
        local ap, as2 = svArea.AbsolutePosition, svArea.AbsoluteSize
        s = math.clamp((pos.X - ap.X) / as2.X, 0, 1)
        v = math.clamp(1 - (pos.Y - ap.Y) / as2.Y, 0, 1)
        color = hsvToRgb(h, s, v)
        syncUI()
    end

    local function hueFromInput(pos)
        local ap, as2 = hueBar.AbsolutePosition, hueBar.AbsoluteSize
        h = math.clamp((pos.X - ap.X) / as2.X, 0, 1)
        color = hsvToRgb(h, s, v)
        syncUI()
    end

    svArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragSV = true; svFromInput(input.Position)
        end
    end)
    hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragHue = true; hueFromInput(input.Position)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if dragSV and hsvContainer.Visible then svFromInput(input.Position) end
            if dragHue and hueBar.Visible then hueFromInput(input.Position) end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragSV, dragHue = false, false
        end
    end)

    -- ====== TOGGLE OPEN/CLOSE ======
    local open = false
    swatch.MouseButton1Click:Connect(function()
        open = not open
        if open then
            panel.Visible = true
            panel.Size = UDim2.new(1, -28, 0, modePanelH[activeMode] or HSV_PANEL_H - 12)
            syncUI()
            tween(row, 0.22, {Size = UDim2.new(1, -8, 0, COLLAPSED_H + OPEN_EXTRA)})
        else
            -- Close to collapsed
            local closingH = COLLAPSED_H
            tween(row, 0.22, {Size = UDim2.new(1, -8, 0, closingH)})
            task.delay(0.22, function() if not open then panel.Visible = false end end)
            -- Stop dragging
            dragSV, dragHue = false, false
        end
    end)

    -- ====== INIT ======
    if opts.Flag then Library.Flags[opts.Flag] = color end
    syncUI()

    -- Set initial mode button style
    modeBtns["HSV"].Button.BackgroundTransparency = 0.55
    modeBtns["HSV"].Label.TextColor3 = theme.AccentDeep
    hsvContainer.Visible = true
    hueBar.Visible = true
    rgbContainer.Visible = false
    hexContainer.Visible = false

    addOrder(row)
    registerSearch(opts.Name, row, "colorpicker", opts.Flag, nil)

    -- Theme refresher
    registerThemeRefresher(function()
        for m, data in pairs(modeBtns) do
            data.Label.TextColor3 = (m == activeMode) and theme.AccentDeep or theme.Muted
        end
    end)

    local obj = {}
    function obj:Set(c)
        color = c
        h, s, v = rgbToHsv(c)
        syncUI()
    end
    function obj:Get() return color end
    registerFlagControl(opts.Flag, obj)
    return obj
end
