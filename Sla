local function colorToHex(c)
    return string.format("%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function hexToColor(hex)
    hex = hex:gsub("#", "")
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    if not (r and g and b) then return nil end
    return Color3.fromRGB(r, g, b)
end
local function rgbToHSV(c) return c:ToHSV() end

local function deriveAccentShades(hex)
    local base = hexToColor(hex) or Color3.fromRGB(178, 34, 60)
    local h, s, v = base:ToHSV()
    local light = Color3.fromHSV(h, math.max(0, s - 0.18), math.min(1, v + 0.25))
    local dim = Color3.fromHSV(h, math.min(1, s + 0.05), math.max(0, v - 0.35))
    return base, light, dim
end
THEME.accent, THEME.accentLight, THEME.accentDim = deriveAccentShades(settings.accentColor)

