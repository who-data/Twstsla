local mediaCache = {}
local function resolveMediaAsset(src, kind)
    if not src or src == "" then return nil end
    if string.match(src, "^rbxassetid://") or string.match(src, "^rbxasset://") or string.match(src, "^%d+$") then
        return string.match(src, "^%d+$") and ("rbxassetid://" .. src) or src
    end
    if mediaCache[src] ~= nil then return mediaCache[src] or nil end
    local resolved
    local ok = pcall(function()
        if type(getcustomasset) ~= "function" then error("no getcustomasset") end
        local cacheFolder = ROOT_FOLDER .. "/cache"
        if not FS.isfolder(cacheFolder) then FS.makefolder(cacheFolder) end
        local ext = (kind == "image" and "png") or (kind == "audio" and "mp3") or "mp4"
        local safeName = string.gsub(HttpService:GenerateGUID(false), "[{}]", "")
        local path = cacheFolder .. "/" .. safeName .. "." .. ext
        local data = game.HttpGet and game:HttpGet(src) or HttpService:GetAsync(src)
        FS.writefile(path, data)
        resolved = getcustomasset(path)
    end)
    mediaCache[src] = ok and resolved or false
    return resolved
end

